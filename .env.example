# ============================================================
# AI Skill Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=60

# --- Database ---
DATABASE_URL=sqlite:///./data/lms.db

# --- JWT Auth ---
SECRET_KEY=change_this_to_a_strong_random_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Application ---
APP_NAME=AI Skill Intelligence Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- FastAPI ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Streamlit ---
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# --- Vector Store ---
VECTOR_STORE_PATH=./vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,pptx

# --- Admin Bootstrap ---
ADMIN_EMAIL=admin@lms.local
ADMIN_PASSWORD=change_this_strong_password
